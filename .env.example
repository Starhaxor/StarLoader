# Copy to .env and replace every placeholder with a unique secret before use.
DATABASE_URL=postgres://starloader:replace-with-a-long-random-password@localhost:5432/starloader?sslmode=disable
LICENSE_HMAC_KEY=replace-with-a-long-random-license-hmac-key
HARDWARE_HMAC_KEY=replace-with-a-long-random-hardware-hmac-key
ED25519_PRIVATE_KEY=replace-with-a-base64-encoded-ed25519-private-key
LICENSE_ISSUER=starloader
LICENSE_AUDIENCE=starloader-client
PRODUCT=StarLoader

# Used only by deploy/compose.yaml for local PostgreSQL.
POSTGRES_DB=starloader
POSTGRES_USER=starloader
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
