# Copy to .env and replace every placeholder before use.
# The password inside DATABASE_URL must equal POSTGRES_PASSWORD.
# Docker-based Go commands connect back to the Windows host with host.docker.internal.
DATABASE_URL=postgres://starloader:replace-with-the-postgres-password@host.docker.internal:5432/starloader?sslmode=disable
LICENSE_HMAC_KEY=replace-with-a-long-random-license-hmac-key
HARDWARE_HMAC_KEY=replace-with-a-long-random-hardware-hmac-key
ED25519_PRIVATE_KEY=replace-with-a-base64-encoded-ed25519-private-key
LICENSE_ISSUER=starloader
LICENSE_AUDIENCE=starloader-client
PRODUCT=StarLoader
LOGIN_TIMEOUT=10s
SERVER_ADDR=:8080
# TRUSTED_PROXIES=127.0.0.1/32

# Used only by deploy/compose.yaml for local PostgreSQL.
POSTGRES_DB=starloader
POSTGRES_USER=starloader
POSTGRES_PASSWORD=replace-with-the-postgres-password
# POSTGRES_PORT=5432
