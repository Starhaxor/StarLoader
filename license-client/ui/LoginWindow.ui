  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget { background: transparent; color: #EAF0FA; }
QFrame#loginCard { background: #0B111B; border: 1px solid #283548; border-radius: 18px; }
QLabel#logoLabel { background: #6D5DFC; color: white; border-radius: 19px; font-size: 17px; font-weight: 800; }
QLabel#titleLabel { color: #F7F9FD; font-size: 23px; font-weight: 800; }
QLabel#subtitleLabel { color: #7F8DA3; font-size: 11px; }
QLineEdit { min-height: 42px; padding: 0 13px; color: #EEF3FB; background: #101824; border: 1px solid #263449; border-radius: 10px; font-size: 12px; }
QLineEdit:hover { border-color: #354761; }
QLineEdit:focus { border: 1px solid #7768FF; background: #121B29; }
QPushButton { min-height: 42px; border-radius: 10px; font-weight: 700; }
QPushButton#loginButton { color: white; background: #6D5DFC; border: none; }
QPushButton#loginButton:hover { background: #7D6FFF; }
QPushButton#loginButton:pressed { background: #594BDB; }
QFrame#divider { color: #202C3D; }
QPushButton#hwidButton { color: #A8B4C7; background: #0E1622; border: 1px solid #263449; text-align: left; padding-left: 14px; }
QPushButton#hwidButton:hover { color: #FFFFFF; background: #141E2D; border-color: #6D5DFC; }</string>
