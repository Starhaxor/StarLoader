/* Adwaita Dark — source-derived Qt 6 Widgets stylesheet
   Palette/state values derived from FedoraQt/adwaita-qt's Adwaita-Dark sources.
   This file intentionally reimplements the appearance in Qt Style Sheet syntax.
*/

QWidget {
    background-color: #0B1117;
    color: #EDF4F6;
    selection-background-color: #22AFC0;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #0B1117;
}

/* Icon-free custom window chrome */
QWidget#windowTitleBar {
    background-color: #0B1117;
    border-bottom: 1px solid #1B2732;
}

QLabel#windowTitleText {
    color: #EDF4F6;
    font-size: 11px;
    font-weight: 600;
}

QToolButton#windowMinimizeButton,
QToolButton#windowCloseButton {
    background-color: transparent;
    color: #eeeeec;
    border: none;
    border-radius: 3px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0;
    font-size: 16px;
}

QToolButton#windowMinimizeButton:hover {
    background-color: #15212B;
}

QToolButton#windowCloseButton:hover {
    background-color: #c01c28;
    color: #ffffff;
}

QToolButton#windowMinimizeButton:pressed {
    background-color: #0D141C;
}

QToolButton#windowCloseButton:pressed {
    background-color: #96151d;
}

QLabel {
    background: transparent;
    color: #EDF4F6;
}

QLabel[dimmed="true"], QLabel:disabled {
    color: #71818A;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #111A22;
    color: #EDF4F6;
    border: 1px solid #22303B;
    border-radius: 7px;
    padding: 0 12px;
    min-height: 38px;
    selection-background-color: #22AFC0;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2AB8C6;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0D141C;
    color: #71818A;
    border-color: #1B2732;
}

/* Buttons */
QPushButton {
    color: #EDF4F6;
    border: 1px solid #22303B;
    border-radius: 7px;
    padding: 6px 12px;
    min-height: 24px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #1B2732, stop:0.90 #18232E, stop:1 #18232E);
}

QPushButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #15212B, stop:0.90 #13202A, stop:1 #13202A);
}

QPushButton:pressed {
    background-color: #0D141C;
    border-color: #1B2732;
}

QPushButton:checked {
    background-color: #0D141C;
    border-color: #1B2732;
}

QPushButton:checked:hover {
    background-color: #111A22;
}

QPushButton:checked:pressed {
    background-color: #0A1016;
}

QPushButton:focus {
    border: 1px solid #2AB8C6;
}

QPushButton:disabled {
    color: #71818A;
    border-color: #1B2732;
    background-color: #0D141C;
}

QPushButton[suggested="true"] {
    color: #EDF4F6;
    border-color: #198A99;
    background-color: #22AFC0;
}

QPushButton[suggested="true"]:hover { background-color: #29BECE; }
QPushButton[suggested="true"]:pressed { background-color: #198A99; }

QPushButton#loginButton,
QPushButton#loginButton[suggested="true"] {
    color: #EDF4F6;
    border-color: #198A99;
    background-color: #22AFC0;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#loginButton:hover,
QPushButton#loginButton[suggested="true"]:hover { background-color: #29BECE; }
QPushButton#loginButton:pressed,
QPushButton#loginButton[suggested="true"]:pressed { background-color: #198A99; }

QPushButton[destructive="true"] {
    color: #ffffff;
    border-color: #7e1015;
    background-color: #b2161d;
}

QPushButton[destructive="true"]:hover { background-color: #c01c28; }

/* Combo */
QComboBox {
    background-color: #3a3a3a;
    color: #eeeeec;
    border: 1px solid #1b1b1b;
    border-radius: 3px;
    padding: 5px 26px 5px 8px;
    min-height: 24px;
}

QComboBox:hover { background-color: #323232; }
QComboBox:focus { border-color: #15539e; }

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #2d2d2d;
    color: #eeeeec;
    border: 1px solid #1b1b1b;
    selection-background-color: #202020;
    selection-color: #ffffff;
    outline: none;
}

/* Checkboxes */
QCheckBox { spacing: 7px; background: transparent; }

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #22303B;
    border-radius: 3px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #1B2732, stop:0.9 #18232E);
}

QCheckBox::indicator:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #22303B, stop:0.9 #1B2732);
}

QCheckBox::indicator:pressed { background-color: #111A22; }

QCheckBox::indicator:checked {
    border-color: #198A99;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #29BECE, stop:0.9 #22AFC0);
}

QCheckBox::indicator:checked:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #35C9D8, stop:0.9 #2BB9C9);
}

QCheckBox::indicator:checked:pressed { background-color: #198A99; }

QCheckBox:disabled { color: #71818A; }
QCheckBox::indicator:disabled { border-color: #1B2732; background-color: #0D141C; }

/* Radios */
QRadioButton { spacing: 7px; background: transparent; }

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #22303B;
    border-radius: 8px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #1B2732, stop:0.9 #18232E);
}

QRadioButton::indicator:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 #22303B, stop:0.9 #1B2732);
}

QRadioButton::indicator:checked {
    border: 4px solid #22AFC0;
    background: #ffffff;
}

QRadioButton::indicator:checked:hover { border-color: #29BECE; }
QRadioButton:disabled { color: #71818A; }

/* Tabs */
QTabWidget::pane {
    background-color: #0B1117;
    border: 1px solid #22303B;
    top: -1px;
}

QTabBar::tab {
    background-color: #0B1117;
    color: #9AAAB2;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 14px;
}

QTabBar::tab:selected {
    color: #EDF4F6;
    border-bottom-color: #22AFC0;
}

QTabBar::tab:hover {
    color: #EDF4F6;
    background-color: #15212B;
}

/* Menus */
QMenuBar {
    background-color: #111A22;
    color: #EDF4F6;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 8px;
}

QMenuBar::item:selected { background-color: #22303B; }

QMenu {
    background-color: #111A22;
    color: #EDF4F6;
    border: 1px solid #22303B;
    padding: 3px;
}

QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #22303B;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #22303B;
    margin: 4px 8px;
}

/* Views */
QAbstractItemView, QListView, QTreeView, QTableView {
    background-color: #111A22;
    alternate-background-color: #15212B;
    color: #EDF4F6;
    border: 1px solid #22303B;
    outline: none;
    selection-background-color: #22AFC0;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #1B2732;
    color: #EDF4F6;
    border: none;
    border-right: 1px solid #1B2732;
    border-bottom: 1px solid #1B2732;
    padding: 5px 8px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #0D141C;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #2E3D4A;
    min-height: 26px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover { background: #3A4C5C; }
QScrollBar::handle:vertical:pressed { background: #22AFC0; }

QScrollBar:horizontal {
    background: #0D141C;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #2E3D4A;
    min-width: 26px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover { background: #3A4C5C; }
QScrollBar::handle:horizontal:pressed { background: #22AFC0; }

QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* Progress */
QProgressBar {
    background-color: #111A22;
    color: #EDF4F6;
    border: 1px solid #22303B;
    border-radius: 3px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #22AFC0;
    border: 1px solid #198A99;
    border-radius: 2px;
}

/* Slider */
QSlider::groove:horizontal {
    background: #111A22;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #22AFC0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #EDF4F6;
    border: 1px solid #22303B;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* Group box */
QGroupBox {
    border: 1px solid #22303B;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 7px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 5px;
    background: #0B1117;
}

/* Toolbars, status, dock */
QToolBar {
    background-color: #111A22;
    border: none;
    border-bottom: 1px solid #22303B;
    spacing: 3px;
}

QToolButton {
    background: transparent;
    color: #EDF4F6;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover { background-color: #15212B; }
QToolButton:pressed, QToolButton:checked { background-color: #0D141C; }

QStatusBar {
    background-color: #111A22;
    color: #9AAAB2;
    border-top: 1px solid #22303B;
}

QDockWidget::title {
    background-color: #111A22;
    color: #EDF4F6;
    padding: 6px;
    border-bottom: 1px solid #22303B;
}

/* Tooltips */
QToolTip {
    background-color: rgba(17,26,34,240);
    color: #EDF4F6;
    border: 1px solid rgba(255,255,255,20);
    padding: 5px;
}

/* Links and semantic labels */
QLabel[link="true"] { color: #44C7D5; }
QLabel[link="true"]:hover { color: #29BECE; }
QLabel[state="warning"] { color: #f57900; }
QLabel[state="error"] { color: #cc0000; }
QLabel[state="success"] { color: #26ab62; }

/* StarLoader helper selectors — mapped to actual UI objectNames */
#loginCard {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}
QFrame#loginCard {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QLabel#titleLabel {
    color: #EDF4F6;
    font-family: "Segoe UI", "Arial";
    font-size: 20pt;
    font-weight: 600;
}

QLabel#subtitleLabel,
QLabel#descriptionLabel {
    color: #9AAAB2;
    font-size: 11px;
}

QLineEdit#emailLineEdit,
QLineEdit#passwordLineEdit {
    font-size: 11px;
}

/* Authenticated dashboard: one compact card and one status accent. */
QFrame#dashboardCard {
    background-color: #0D141C;
    border: 1px solid #1B2732;
    border-radius: 6px;
}

QLabel#dashboardBrandLabel {
    color: #EDF4F6;
    font-family: "Segoe UI", "Arial";
    font-size: 20pt;
    font-weight: 600;
}

QLabel#activeStatusIndicator {
    color: #8ff0a4;
    background-color: #1f3b2a;
    border: 1px solid #2f6540;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#emailLabel,
QLabel#accountStatusLabel,
QLabel#productLabel,
QLabel#licenseStatusLabel,
QLabel#licenseExpiryLabel,
QLabel#maxDevicesLabel,
QLabel#deviceStatusLabel,
QLabel#deviceIdLabel,
QLabel#hwidLabel,
QLabel#sessionExpiryLabel {
    color: #9AAAB2;
    font-size: 11px;
}

QLabel#emailValue,
QLabel#accountStatusValue,
QLabel#productValue,
QLabel#licenseStatusValue,
QLabel#licenseExpiryValue,
QLabel#maxDevicesValue,
QLabel#deviceStatusValue,
QLabel#deviceIdValue,
QLabel#hwidValue,
QLabel#sessionExpiryValue {
    color: #EDF4F6;
    font-size: 11px;
}

QPushButton#signOutButton {
    min-width: 96px;
}

QLabel#hwidLink {
    color: #76949D;
    font-size: 10px;
}

QLabel#hwidLink:hover {
    color: #44C7D5;
}

/* HWID dialog — same palette as the login form */
QDialog#HwidDialog {
    background-color: #0B1117;
}

QLineEdit#hwidLineEdit {
    background-color: #111A22;
    color: #EDF4F6;
    border: 1px solid #22303B;
    border-radius: 7px;
    padding: 0 12px;
    min-height: 34px;
    font-size: 12px;
    selection-background-color: #22AFC0;
    selection-color: #ffffff;
}

QLineEdit#hwidLineEdit:focus {
    border: 1px solid #2AB8C6;
}

QToolButton#copyButton {
    background-color: #1B2732;
    color: #EDF4F6;
    border: 1px solid #22303B;
    border-radius: 7px;
}

QToolButton#copyButton:hover {
    background-color: #15212B;
}

QToolButton#copyButton:pressed {
    background-color: #0D141C;
}
